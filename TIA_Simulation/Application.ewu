  object Application::Led CycleLed
  {
    preset Bounds = <135,146,166,189>;
  }

  $rect <560,680,760,720>
  slot onSetCycle
  {
    if (motorReady)
      cycleValue = 1;
    else
      cycleValue = 0;
  }

  $rect <770,703,970,743>
  property int16 cycleValue;

  $rect <990,703,1190,743>
  onset cycleValue
  {
    // The value doesn't change - nothing to do.
    if ( pure cycleValue == value )
      return;

    // Remember the property's new value.
    pure cycleValue = value;
    CycleLed.ledState = value;

    if (cycleOutlet != null && motorReady)
    {
      if (value == 1)
      {
        cycleOutlet^ = true;
      }
      else
      {
        cycleOutlet^ = false;
      }
    }
    else if ( cycleOutlet != null && !motorReady)
      cycleOutlet^ = false;
    // TO DO:
    // 
    // Now you can handle the alternation of the property.
  }

  $rect <1210,703,1410,743>
  property ^bool cycleOutlet;

  $rect <1430,703,1630,743>
  onset cycleOutlet
  {
    // The value doesn't change - nothing to do.
    if ( pure cycleOutlet == value )
      return;

    // Remember the property's new value.
    //trace value;
    pure cycleOutlet = value;

    // TO DO:
    // 
    // Now you can handle the alternation of the property.
  }

  $rect <560,730,760,770>
  slot onResetCycle
  {
    cycleValue = 0;
  }

  $rect <780,830,980,870>
  slot checkMotorStatus
  {
    if ((cwValue == 1 && ccwValue == 1) || ((cwValue == 1 || ccwValue == 1) && cycleValue == 1))
    {
      FaultStatus = true;
    }
    if (!FaultStatus)
    {
      motorReady = true;
    }

  }

  $rect <560,830,760,870>
  object Core::Timer Timer
  {
    preset OnTrigger = checkMotorStatus;
    preset Period = 1;
    preset Enabled = true;
  }

  $rect <20,20,160,60>
  object Core::SimpleTouchHandler ModifyCycleCounterTouch
  {
    preset Point4 = <102,189>;
    preset Point3 = <177,189>;
    preset Point2 = <177,222>;
    preset Point1 = <102,222>;
    preset OnPress = CycleCounterTouchSlot;
  }

  $rect <1690,482,1890,522>
  slot CycleCounterTouchSlot
  {
    NumKeyboard.Visible = true;
    NumKeyboard.Enabled = true;
    NumKeyboard.generatedNumber  = 0;
    var Application::MainPage mainPageRef = (Application::MainPage)rootthis;
    mainPageRef.touch(false);
  }

  $rect <20,20,160,60>
  object Core::SimpleTouchHandler EnterTouch
  {
    preset Point4 = <398,188>;
    preset Point3 = <473,188>;
    preset Point2 = <473,250>;
    preset Point1 = <398,250>;
    preset OnPress = ClearKeyBoard;
  }

  $rect <1690,540,1890,580>
  slot ClearKeyBoard
  {
    CycleCounterValue.String = string(NumKeyboard.generatedNumber);
    NumKeyboard.Visible = false;
    NumKeyboard.Enabled = false;
    var Application::MainPage mainPageRef = (Application::MainPage)rootthis;
    mainPageRef.touch(true);
  }

  $rect <20,20,160,60>
  object Application::NumKeyboard NumKeyboard
  {
    preset Bounds = <285,34,478,254>;
    preset Enabled = false;
    preset Embedded = false;
    preset Visible = false;
  }

  // Diagnosis
