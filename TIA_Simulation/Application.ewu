  $rect <782,503,982,543>
  property int16 cwValue;

  $rect <1002,503,1202,543>
  onset cwValue
  {
    // The value doesn't change - nothing to do.
    if ( pure cwValue == value )
      return;

    // Remember the property's new value.
    pure cwValue = value;
    CWLed.ledState = value;
    if ( cwOutlet != null && motorReady)
    {
      if ( value == 0 )
      {
        cwOutlet^ = false;
      }
      else
      {
         cwOutlet^ = true;
      }

    }
    else if ( cwOutlet != null && !motorReady)
      cwOutlet^ = false;
    // TO DO:
    // 
    // Now you can handle the alternation of the property.
  }

