    preset Embedded = false;
  }

  $rect <410,0,610,40>
  property bool enabled;

  $rect <410,40,610,80>
  onset enabled
  {
    // The value doesn't change - nothing to do.
    if ( pure enabled == value )
      return;

    // Remember the property's new value.
    pure enabled = value;
    if (type == "Fault" && enabled)
      Rectangle.Color = #D60802FF;
    else if (type == "Warning" && enabled)
      Rectangle.Color = #F68F00FF;
    else if ((type == "Fault" || type == "Warning") && !enabled)
      Rectangle.Color = #D6D6D6FF;

  }

  $rect <170,0,370,40>
